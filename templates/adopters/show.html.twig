{% extends 'base.html.twig' %}

{% block title %}Adopters{% endblock %}

{% block body %}
    <h1>Adopters</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ adopter.id }}</td>
            </tr>
            <tr>
                <th>Firth_name</th>
                <td>{{ adopter.firthName }}</td>
            </tr>
            <tr>
                <th>Last_name</th>
                <td>{{ adopter.lastName }}</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>{{ adopter.address }}</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>{{ adopter.country }}</td>
            </tr>
            <tr>
                <th>City</th>
                <td>{{ adopter.city }}</td>
            </tr>
            <tr>
                <th>Zip_code</th>
                <td>{{ adopter.zipCode }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_adopters_index') }}">back to list</a>

    <a href="{{ path('app_adopters_edit', {'id': adopter.id}) }}">edit</a>

    {{ include('adopters/_delete_form.html.twig') }}
{% endblock %}
