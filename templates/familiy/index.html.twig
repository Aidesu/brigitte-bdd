{% extends 'base.html.twig' %}

{% block title %}Familiy index{% endblock %}

{% block body %}
    <h1>Familiy index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for familiy in familiys %}
            <tr>
                <td>{{ familiy.id }}</td>
                <td>{{ familiy.name }}</td>
                <td>
                    <a href="{{ path('app_familiy_show', {'id': familiy.id}) }}">show</a>
                    <a href="{{ path('app_familiy_edit', {'id': familiy.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_familiy_new') }}">Create new</a>
{% endblock %}
