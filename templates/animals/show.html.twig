{% extends 'base.html.twig' %}

{% block title %}Animals{% endblock %}

{% block body %}
    <h1>Animals</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ animal.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ animal.name }}</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>{{ animal.gender }}</td>
            </tr>
            <tr>
                <th>Origin</th>
                <td>{{ animal.origin }}</td>
            </tr>
            <tr>
                <th>Birth_date</th>
                <td>{{ animal.birthDate ? animal.birthDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Arriving_date</th>
                <td>{{ animal.arrivingDate ? animal.arrivingDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Comment</th>
                <td>{{ animal.comment }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_animals_index') }}">back to list</a>

    <a href="{{ path('app_animals_edit', {'id': animal.id}) }}">edit</a>

    {{ include('animals/_delete_form.html.twig') }}
{% endblock %}
