{% extends 'base.html.twig' %}

{% block title %}Aisle index{% endblock %}

{% block body %}
    <h1>Aisle index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for aisle in aisles %}
            <tr>
                <td>{{ aisle.id }}</td>
                <td>{{ aisle.name }}</td>
                <td>
                    <a href="{{ path('app_aisle_show', {'id': aisle.id}) }}">show</a>
                    <a href="{{ path('app_aisle_edit', {'id': aisle.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_aisle_new') }}">Create new</a>
{% endblock %}
