{% extends 'base.html.twig' %}

{% block title %}Genus index{% endblock %}

{% block body %}
    <h1>Genus index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for genu in genera %}
            <tr>
                <td>{{ genu.id }}</td>
                <td>{{ genu.name }}</td>
                <td>
                    <a href="{{ path('app_genus_show', {'id': genu.id}) }}">show</a>
                    <a href="{{ path('app_genus_edit', {'id': genu.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_genus_new') }}">Create new</a>
{% endblock %}
