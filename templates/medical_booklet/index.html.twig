{% extends 'base.html.twig' %}

{% block title %}MedicalBooklet index{% endblock %}

{% block body %}
    <h1>MedicalBooklet index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Vaccine_date</th>
                <th>Vaccine_next_day</th>
                <th>Disease</th>
                <th>Vaccine</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for medical_booklet in medical_booklets %}
            <tr>
                <td>{{ medical_booklet.id }}</td>
                <td>{{ medical_booklet.vaccineDate ? medical_booklet.vaccineDate|date('Y-m-d') : '' }}</td>
                <td>{{ medical_booklet.vaccineNextDay ? medical_booklet.vaccineNextDay|date('Y-m-d') : '' }}</td>
                <td>
    {% if medical_booklet.disease is not empty %}
        {% for disease in medical_booklet.disease %}
            {{ disease.name }}<br>
        {% endfor %}
    {% else %}
        no entry
    {% endif %}
</td>
                <td>
    {% if medical_booklet.vaccine is not empty %}
        {% for vaccine in medical_booklet.vaccine %}
            {{ vaccine.name }}<br>
        {% endfor %}
    {% else %}
        no entry
    {% endif %}
</td>
                <td>
                    <a href="{{ path('app_medical_booklet_show', {'id': medical_booklet.id}) }}">show</a>
                    <a href="{{ path('app_medical_booklet_edit', {'id': medical_booklet.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_medical_booklet_new') }}">Create new</a>
{% endblock %}
