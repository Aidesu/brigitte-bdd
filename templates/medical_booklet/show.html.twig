{% extends 'base.html.twig' %}

{% block title %}MedicalBooklet{% endblock %}

{% block body %}
    <h1>MedicalBooklet</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ medical_booklet.id }}</td>
            </tr>
            <tr>
                <th>Vaccine_date</th>
                <td>{{ medical_booklet.vaccineDate ? medical_booklet.vaccineDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Vaccine_next_day</th>
                <td>{{ medical_booklet.vaccineNextDay ? medical_booklet.vaccineNextDay|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_medical_booklet_index') }}">back to list</a>

    <a href="{{ path('app_medical_booklet_edit', {'id': medical_booklet.id}) }}">edit</a>

    {{ include('medical_booklet/_delete_form.html.twig') }}
{% endblock %}
