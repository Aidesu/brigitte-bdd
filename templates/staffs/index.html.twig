{% extends 'base.html.twig' %}

{% block title %}Staffs index{% endblock %}

{% block body %}
    <h1>Staffs index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>BirtDate</th>
                <th>Gender</th>
                <th>City</th>
                <th>Role</th>
                <th>Aisle</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for staff in staffs %}
            <tr>
                <td>{{ staff.id }}</td>
                <td>{{ staff.name }}</td>
                <td>{{ staff.birtDate }}</td>
                <td>{{ staff.gender }}</td>
                <td>{{ staff.city }}</td>
                <td>{{ staff.role }}</td>
                <td>{{ staff.aisle }}</td>
                <td>
                    <a href="{{ path('app_staffs_show', {'id': staff.id}) }}">show</a>
                    <a href="{{ path('app_staffs_edit', {'id': staff.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_staffs_new') }}">Create new</a>
{% endblock %}
